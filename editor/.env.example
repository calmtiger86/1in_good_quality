# ═══════════════════════════════════════════════════════
#  editor/ 환경변수 템플릿 (Next.js 앱)
#  복사: cp .env.example .env.local
#  .env.local 은 .gitignore 포함 — 절대 커밋 금지
# ═══════════════════════════════════════════════════════

# ─── Coupang Partners API ────────────────────────────────
# app/api/affiliate/route.ts 에서 사용
# 미설정 시 자동으로 수동입력 UI로 전환
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_VENDOR_ID=

# ─── AI 이미지 생성 API ───────────────────────────────────
# app/api/generate-image/route.ts 에서 사용
# 미설정 시 생성 버튼 비활성화 (503 반환)
IMAGE_GEN_API_KEY=
IMAGE_GEN_API_URL=

# ─── 접근 제한 ───────────────────────────────────────────
# middleware.ts 에서 사용. 미설정 시 모든 접근 차단
SITE_PASSWORD=

# ─── Firecrawl (제품 정보 추출) ───────────────────────────
# app/api/extract/route.ts 에서 사용. https://firecrawl.dev 에서 발급
FIRECRAWL_API_KEY=

# ─── Claude API (제품 추출 + 카피라이팅) ─────────────────
# app/api/extract/route.ts 에서 사용. https://console.anthropic.com 에서 발급
# 미설정 시 기존 정규식 파싱으로 폴백 (추출 품질 저하 가능)
ANTHROPIC_API_KEY=

# ─── 앱 설정 ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
